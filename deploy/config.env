# hush-website 的非敏感部署配置：GitHub Actions 部署与 deploy/setup-lb.sh 共用这一份。
GCP_PROJECT_ID=gtxy-rzn-infra
GCP_REGION=us-east1
ARTIFACT_REGISTRY=rezonago-repo
IMAGE_NAME=hush-website
SERVICE_NAME=hush-website-production
MAX_SCALE=5
# 构建期写入 canonical / hreflang 的站点地址；其域名即主域名。
SITE_URL=https://myhush.ai
# 托管证书覆盖的全部域名（逗号分隔）；主域名以外的域名在 LB 上 301 到主域名。
# 证书创建后域名不可修改，变更时需要换新的 LB_CERT_NAME。
DOMAINS=myhush.ai,www.myhush.ai
# Global External Application LB 资源名称（静态 IP 挂在这个 LB 上）。
LB_IP_NAME=hush-website-ip
LB_CERT_NAME=hush-website-cert
LB_NEG=hush-website-neg
LB_BACKEND=hush-website-backend
LB_URL_MAP=hush-website-url-map
LB_REDIRECT_URL_MAP=hush-website-http-redirect
LB_HTTPS_PROXY=hush-website-https-proxy
LB_HTTP_PROXY=hush-website-http-proxy
LB_HTTPS_RULE=hush-website-https-rule
LB_HTTP_RULE=hush-website-http-rule
